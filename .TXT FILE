#include <iostream>
#include <fstream>
using namespace std;

bool isIdentifier(char str[]) {
    if (!((str[0] >= 'A' && str[0] <= 'Z') ||
          (str[0] >= 'a' && str[0] <= 'z') ||
          str[0] == '_'))
        return false;

    for (int i = 1; str[i] != '\0'; i++) {
        if (!((str[i] >= 'A' && str[i] <= 'Z') ||
              (str[i] >= 'a' && str[i] <= 'z') ||
              (str[i] >= '0' && str[i] <= '9') ||
              str[i] == '_'))
            return false;
    }
    return true;
}

int main() {

    ifstream fin("input.txt");   // input file
    ofstream fout("output.txt"); // output file

    char str[100];

    if (!fin) {
        cout << "input.txt not found!" << endl;
        return 0;
    }

    fin >> str;  // Read string from the text file
    
    cout << "Checking Identifier for: " << str << endl;

    if (isIdentifier(str)) {
        cout << "It is a valid identifier." << endl;
        fout << "Input: " << str << endl;
        fout << "Result: Valid Identifier" << endl;
    }
    else {
        cout << "It is NOT a valid identifier." << endl;
        fout << "Input: " << str << endl;
        fout << "Result: Invalid Identifier" << endl;
    }

    fin.close();
    fout.close();

    return 0;
}
